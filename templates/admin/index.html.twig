{% extends 'base.html.twig' %}

{% block title %}Stubborn - Back-Office{% endblock %}

{% block body %}
    <h1 class="admin-title">Back-Office</h1>

    <div class="admin-item admin-item-add">
        <form method="post" action="{{ path('app_admin_add') }}" class="admin-form">
            <div class="admin-image-placeholder">Image</div>

            <div class="admin-fields">
                <label>Nom
                    <input type="text" name="name" required>
                </label>
                <label>Prix
                    <input type="number" step="0.01" name="price" required>
                </label>
                <label>Image (nom du fichier)
                    <input type="text" name="image" placeholder="ex: nouveaunom.jpeg" required>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" name="featured" value="1">
                    Mettre en avant sur l'accueil
                </label>

                <div class="stock-fields">
                    {% for size in sizes %}
                        <label>Stock {{ size }}
                            <input type="number" name="stock_{{ size }}" value="0" min="0">
                        </label>
                    {% endfor %}
                </div>
            </div>

            <button type="submit" class="btn btn-primary">AJOUTER</button>
        </form>
    </div>

    {% for sweatshirt in sweatshirts %}
        <div class="admin-item">
            <form method="post" action="{{ path('app_admin_update', {id: sweatshirt.id}) }}" class="admin-form">
                <div class="admin-image">
                    <img src="{{ asset('uploads/sweatshirts/' ~ sweatshirt.image) }}" alt="{{ sweatshirt.name }}">
                </div>

                <div class="admin-fields">
                    <label>Nom
                        <input type="text" name="name" value="{{ sweatshirt.name }}" required>
                    </label>
                    <label>Prix
                        <input type="number" step="0.01" name="price" value="{{ sweatshirt.price }}" required>
                    </label>
                    <label>Image (nom du fichier)
                        <input type="text" name="image" value="{{ sweatshirt.image }}" required>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" name="featured" value="1" {{ sweatshirt.featured ? 'checked' }}>
                        Mis en avant sur l'accueil
                    </label>

                    <div class="stock-fields">
                        {% for stock in sweatshirt.stocks %}
                            <label>Stock {{ stock.size }}
                                <input type="number" name="stock_{{ stock.size }}" value="{{ stock.quantity }}" min="0">
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div class="admin-actions">
                    <button type="submit" class="btn btn-primary">MODIFIER</button>
                </div>
            </form>

            <form method="post" action="{{ path('app_admin_delete', {id: sweatshirt.id}) }}" onsubmit="return confirm('Supprimer ce sweat-shirt ?');">
                <button type="submit" class="btn btn-danger">SUPPRIMER</button>
            </form>
        </div>
    {% endfor %}
{% endblock %}