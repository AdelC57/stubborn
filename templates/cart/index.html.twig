{% extends 'base.html.twig' %}

{% block title %}Stubborn - Panier{% endblock %}

{% block body %}
    <div class="cart-list">
        {% for item in items %}
            <div class="cart-item">
                <div class="cart-item-image">
                    <img src="{{ asset('uploads/sweatshirts/' ~ item.sweatshirt.image) }}" alt="{{ item.sweatshirt.name }}">
                </div>
                <p class="cart-item-name">{{ item.sweatshirt.name }}</p>
                <p class="cart-item-price">{{ item.sweatshirt.price }} €</p>
                <p class="cart-item-size">Taille : {{ item.size }}</p>
                <p class="cart-item-qty">Quantité : {{ item.quantity }}</p>

                <form method="post" action="{{ path('app_cart_remove', {id: item.sweatshirt.id, size: item.size}) }}">
                    <button type="submit" class="btn btn-outline">RETIRER DU PANIER</button>
                </form>
            </div>
        {% else %}
            <p>Votre panier est vide.</p>
        {% endfor %}
    </div>

    {% if items|length > 0 %}
        <div class="cart-summary">
            <p class="cart-total">TOTAL : {{ total }} €</p>
            {# <a href="{{ path('app_checkout') }}" class="btn btn-danger">FINALISER MA COMMANDE</a> #}
<a href="{{ path('app_checkout') }}" class="btn btn-danger">FINALISER MA COMMANDE</a>
            <a href="{{ path('app_products') }}" class="btn btn-success">CONTINUER MES ACHATS</a>
        </div>
    {% endif %}
{% endblock %}