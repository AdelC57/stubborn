{% extends 'base.html.twig' %}

{% block title %}Stubborn - Boutique{% endblock %}

{% block body %}
    <div class="products-layout">
        <aside class="price-filter">
            <p class="filter-title">Fourchette de prix</p>
            <ul>
                <li><a href="{{ path('app_products') }}" class="{{ currentPriceRange is null ? 'active' }}">Tous les prix</a></li>
                <li><a href="{{ path('app_products', {price_range: '10-29'}) }}" class="{{ currentPriceRange == '10-29' ? 'active' }}">10 à 29 €</a></li>
                <li><a href="{{ path('app_products', {price_range: '29-35'}) }}" class="{{ currentPriceRange == '29-35' ? 'active' }}">29 à 35 €</a></li>
                <li><a href="{{ path('app_products', {price_range: '35-50'}) }}" class="{{ currentPriceRange == '35-50' ? 'active' }}">35 à 50 €</a></li>
            </ul>
        </aside>

        <div class="products-grid">
            {% for sweatshirt in sweatshirts %}
                <div class="product-card">
                    <div class="product-image">
                        <img src="{{ asset('uploads/sweatshirts/' ~ sweatshirt.image) }}" alt="{{ sweatshirt.name }}">
                    </div>
                    <p class="product-name">{{ sweatshirt.name }}</p>
                    <p class="product-price">{{ sweatshirt.price }} €</p>
                    <a href="{{ path('app_product_show', {id: sweatshirt.id}) }}" class="btn btn-outline">VOIR</a>
                </div>
            {% else %}
                <p>Aucun sweat-shirt dans cette fourchette de prix.</p>
            {% endfor %}
        </div>
    </div>

    <p><a href="{{ path('app_home') }}">← Retour à l'accueil</a></p>
{% endblock %}