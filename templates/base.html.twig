<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Stubborn{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <div class="brand">
                <div class="logo-box">Stubborn</div>
                <p class="slogan">Don't compromise on your look</p>
            </div>
            <nav class="main-nav">
                {% if app.user %}
                    <a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' }}">Accueil</a>
                    <a href="{{ path('app_products') }}" class="{{ app.request.attributes.get('_route') == 'app_products' ? 'active' }}">Boutique</a>
                    <a href="{{ path('app_cart') }}" class="{{ app.request.attributes.get('_route') == 'app_cart' ? 'active' }}">Panier</a>
                    <a href="{{ path('app_logout') }}">Se déconnecter</a>
                {% else %}
                    <a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' }}">Accueil</a>
                    <a href="{{ path('app_register') }}" class="{{ app.request.attributes.get('_route') == 'app_register' ? 'active' }}">S'inscrire</a>
                    <a href="{{ path('app_login') }}" class="{{ app.request.attributes.get('_route') == 'app_login' ? 'active' }}">Se connecter</a>
                {% endif %}
            </nav>
        </header>

        <main class="site-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <p>Stubborn — Piccadilly Circus, London W1J 0DA, Royaume-Uni — stubborn@blabla.com</p>
        </footer>
    </body>
</html>